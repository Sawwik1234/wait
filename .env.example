# --- CaseArena environment ---
# Dev (default, zero-dependency): SQLite profile
DATABASE_URL="file:./dev.db"
# Production (docker-compose):
# DATABASE_URL="postgresql://casearena:casearena@postgres:5432/casearena?schema=public"

PORT=4000

# REQUIRED in production
JWT_SECRET="change-me-to-a-long-random-string"

ADMIN_EMAIL="admin@casearena.local"
ADMIN_PASSWORD="Admin#12345"

WEB_ORIGIN="http://localhost:3000"

# Live feed: bots open cases through the real pipeline (0 = off)
LIVEFEED_ENABLED="1"
LIVEFEED_INTERVAL_MS="9000"
